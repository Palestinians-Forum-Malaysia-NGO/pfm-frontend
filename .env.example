# Copy this file to .env.local and fill in your values
# Never commit .env.local to git

# Backend API base URL (set this in Vercel project settings too)
REACT_APP_API_URL=https://staging-api.pfmy.org/api/v1

# Required for the CSP script-src in public/index.html to work — without this,
# CRA inlines the webpack runtime as an inline <script>, which a strict CSP blocks.
# Set this in Vercel project settings too.
INLINE_RUNTIME_CHUNK=false
