# Copy this file to e2e/.env.e2e and fill in real staging test-account
# credentials. e2e/.env.e2e is gitignored — never commit real credentials
# for any of these accounts.

E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

E2E_BENEFICIARY_EMAIL=
E2E_BENEFICIARY_PASSWORD=

E2E_STAFF_EMAIL=
E2E_STAFF_PASSWORD=

# A dedicated account created via register.unauth.spec.js, then approved +
# had its password set out-of-band — see beneficiary-journey.unauth.spec.js.
PLAYWRIGHT_JOURNEY_EMAIL=
PLAYWRIGHT_JOURNEY_PASSWORD=
